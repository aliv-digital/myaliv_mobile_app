default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Bootstrap Match: create/sync certs + profiles for a bundle (local use only)"
  lane :match_bootstrap do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key_filepath: ENV["APPLE_API_KEY_PATH"],
      in_house: false,
    )

    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      app_identifier: options[:app_identifier] || "new.app.myaliv",
      force_for_new_devices: false,
    )
  end

  desc "Build signed IPA and upload to TestFlight (internal testing)"
  lane :beta do |options|
    build_number = options[:build_number] || Time.now.to_i.to_s

    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key_filepath: ENV["APPLE_API_KEY_PATH"],
      in_house: false,
    )

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      force_for_new_devices: false,
    )

    profile_name = ENV["sigh_new.app.myaliv_appstore_profile-name"]
    UI.message("Using provisioning profile: #{profile_name}")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      bundle_identifier: "new.app.myaliv",
      profile_name: profile_name,
      code_sign_identity: "Apple Distribution",
      targets: ["Runner"],
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "MyAliv.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        provisioningProfiles: {
          "new.app.myaliv" => profile_name,
        },
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: ENV["APPLE_TEAM_ID"],
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["RELEASE_NOTES"] || "Build #{build_number}",
    )
  end
end
